<% content_for :page_title, @minute.title %>
<% content_for :page_subtitle, "Generated meeting transcript and minutes." %>

<div
  class="space-y-6"
  data-controller="auto-refresh"
  data-auto-refresh-status-value="<%= @minute.status %>"
  data-auto-refresh-interval-value="5000"
>
  <% if @minute.processing? %>
    <div class="bg-blue-50 border border-blue-200 text-blue-800 p-4 text-sm flex items-center gap-2">
      <%= lucide_icon "loader-circle", class: "w-5 h-5" %>
      Minutes are currently processing. This page will refresh automatically.
    </div>
  <% end %>

  <% if @minute.failed? %>
    <div class="bg-red-50 border border-red-200 text-red-800 p-4 text-sm flex items-center gap-2">
      <%= lucide_icon "triangle-alert", class: "w-5 h-5" %>
      Minutes extraction failed. Please try again or upload a smaller/clearer audio file.
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 p-5">
    <p class="text-sm text-gray-500">
      Uploaded by <%= @minute.created_by.display_name %> ·
      <%= @minute.created_at.strftime("%d %b %Y, %I:%M %p") %>
    </p>

    <p class="text-sm mt-2 inline-flex items-center gap-1">
      <%= lucide_icon "circle", class: "w-3 h-3" %>
      Status:
      <span class="font-semibold capitalize"><%= @minute.status %></span>
    </p>

    <% if @minute.audio_file.attached? %>
      <div class="mt-4">
        <p class="text-sm font-medium text-slate-700 mb-2 flex items-center gap-2">
          <%= lucide_icon "audio-lines", class: "w-4 h-4 text-green-700" %>
          Audio File
        </p>

        <audio controls class="w-full">
          <source src="<%= url_for(@minute.audio_file) %>">
        </audio>
      </div>
    <% end %>

    <% if @minute.pending? || @minute.failed? %>
      <div class="mt-4">
        <%= button_to process_minutes_minute_path(@minute),
            method: :post,
            class: "#{btn_primary} inline-flex items-center gap-2" do %>
          <%= lucide_icon "wand-sparkles", class: "w-4 h-4" %>
          Process Minutes
        <% end %>
      </div>
    <% end %>

    <% if @minute.completed? %>
      <div class="mt-4">
        <%= link_to minute_path(@minute, format: :pdf),
            class: "inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 text-sm font-medium" do %>
          <%= lucide_icon "download", class: "w-4 h-4" %>
          Download PDF
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 p-5">
    <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
      <%= lucide_icon "file-text", class: "w-5 h-5 text-green-700" %>
      Transcript
    </h3>

    <p class="text-sm text-gray-700 whitespace-pre-line">
      <%= @minute.transcript.presence || "Transcript has not been generated yet." %>
    </p>
  </div>

  <div class="bg-white border border-gray-200 p-5">
    <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
      <%= lucide_icon "clipboard-list", class: "w-5 h-5 text-green-700" %>
      Generated Minutes
    </h3>

    <p class="text-sm text-gray-700 whitespace-pre-line">
      <%= @minute.summary.presence || "Meeting minutes have not been generated yet." %>
    </p>
  </div>

  <div class="bg-white border border-gray-200 p-5">
    <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
      <%= lucide_icon "list-checks", class: "w-5 h-5 text-green-700" %>
      Action Items
    </h3>

    <p class="text-sm text-gray-700 whitespace-pre-line">
      <%= @minute.action_items.presence || "No action items generated yet." %>
    </p>
  </div>
</div>