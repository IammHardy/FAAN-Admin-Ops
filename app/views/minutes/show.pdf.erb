<div style="font-family: Arial, sans-serif; color:#0f172a; font-size:12px;">

  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <%= image_tag wicked_pdf_asset_base64("faan-logo.png"),
        style: "width:180px; height:auto;" %>

    <div style="font-size:11px; text-align:right; color:#475569;">
      <strong>Generated On</strong><br>
      <%= Time.current.strftime("%d %B %Y, %I:%M %p") %>
    </div>
  </div>

  <h3 style="text-align:center; margin:20px 0; text-transform:uppercase; font-size:16px;">
    <%= @minute.title.presence || "MINUTES OF MEETING" %>
  </h3>

  <hr style="margin: 20px 0; border:0; border-top:1px solid #cbd5e1;">

  <div style="font-size:12px; line-height:1.8; color:#0f172a;">
    <%= simple_format(@minute.summary.presence || "No minutes generated.") %>
  </div>

  <div style="margin-top:30px; border-top:1px solid #cbd5e1; padding-top:10px; font-size:10px; color:#64748b; text-align:center;">
    Generated by FAAN Operations Admin System
  </div>

</div>