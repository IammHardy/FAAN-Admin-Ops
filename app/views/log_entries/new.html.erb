<% content_for :page_title, "New Log Entry" %>
<% content_for :page_subtitle, "Add a new entry to this daily log report." %>

<div class="max-w-3xl bg-white border border-slate-200 p-6">
  <%= form_with model: [@log_report, @log_entry], class: "space-y-5" do |f| %>
    <% if @log_entry.errors.any? %>
      <div class="border border-red-300 bg-red-50 p-4 text-sm text-red-800">
        <p class="font-semibold mb-2">Please fix the following errors:</p>

        <ul class="list-disc ml-5 space-y-1">
          <% @log_entry.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :entry_time, class: "block text-sm font-medium mb-1" %>
      <%= f.time_field :entry_time, class: "w-full border border-slate-300 px-3 py-2 text-sm rounded-lg" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border border-slate-300 px-3 py-2 text-sm rounded-lg" %>
    </div>

    <div>
      <%= f.label :action_taken, class: "block text-sm font-medium mb-1" %>
      <%= f.text_area :action_taken, rows: 3, class: "w-full border border-slate-300 px-3 py-2 text-sm rounded-lg" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :incident_flag, class: "h-4 w-4" %>
      <%= f.label :incident_flag, "Flag as incident", class: "text-sm font-medium" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :follow_up_needed, class: "h-4 w-4" %>
      <%= f.label :follow_up_needed, "Follow-up needed", class: "text-sm font-medium" %>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= button_tag type: :submit,
          class: "#{btn_primary} inline-flex items-center gap-2" do %>
        <%= lucide_icon "save", class: "w-4 h-4" %>
        Save Log Entry
      <% end %>

      <%= link_to log_report_path(@log_report),
          class: "#{btn_secondary} inline-flex items-center gap-2" do %>
        <%= lucide_icon "arrow-left", class: "w-4 h-4" %>
        Back to Log Report
      <% end %>
    </div>
  <% end %>
</div>