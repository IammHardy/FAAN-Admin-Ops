<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
      <%= lucide_icon "folder-kanban", class: "w-6 h-6 text-green-700" %>
      Operations Staff
    </h1>

    <p class="text-slate-500 mt-1">
      Staff folders and personal records.
    </p>
  </div>

  <%= link_to new_operation_staff_path,
      class: "inline-flex items-center gap-2 bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-800" do %>
    <%= lucide_icon "plus", class: "w-4 h-4" %>
    Add Staff
  <% end %>
</div>

<div class="bg-white border border-slate-200 shadow-sm p-4 mb-6">
  <%= form_with url: operation_staffs_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-5 gap-3" do %>
    <%= text_field_tag :query,
        params[:query],
        placeholder: "Search name or staff no...",
        class: "rounded-lg border-slate-300" %>

    <%= select_tag :unit,
        options_for_select([["All Units", ""]] + OperationStaff.distinct.order(:unit).pluck(:unit).compact_blank.map { |u| [u, u] }, params[:unit]),
        class: "rounded-lg border-slate-300" %>

    <%= select_tag :designation,
        options_for_select([["All Designations", ""]] + OperationStaff.distinct.order(:designation).pluck(:designation).compact_blank.map { |d| [d, d] }, params[:designation]),
        class: "rounded-lg border-slate-300" %>

    <%= select_tag :employment_status,
        options_for_select([["All Status", ""], ["Permanent Staff", "Permanent Staff"], ["Contract Staff", "Contract Staff"], ["NYSC", "NYSC"], ["IT Student", "IT Student"]], params[:employment_status]),
        class: "rounded-lg border-slate-300" %>

    <div class="flex gap-2">
      <%= button_tag type: :submit,
          class: "inline-flex items-center justify-center gap-2 bg-slate-900 text-white px-4 py-2 rounded-lg" do %>
        <%= lucide_icon "filter", class: "w-4 h-4" %>
        Filter
      <% end %>

      <%= link_to operation_staffs_path,
          class: "inline-flex items-center gap-2 border border-slate-300 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-50" do %>
        <%= lucide_icon "rotate-ccw", class: "w-4 h-4" %>
        Reset
      <% end %>
    </div>
  <% end %>
</div>

<div class="bg-white shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-100">
      <tr>
        <th class="text-left p-3">Staff</th>
        <th class="text-left p-3">Designation</th>
        <th class="text-left p-3">Unit</th>
        <th class="text-left p-3">Documents</th>
        <th class="text-left p-3">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @operation_staffs.each do |staff| %>
        <tr class="border-t">
          <td class="p-3 font-medium">
            <%= staff.full_name %>
          </td>

          <td class="p-3">
            <%= staff.designation.presence || "—" %>
          </td>

          <td class="p-3">
            <%= staff.unit.presence || "—" %>
          </td>

          <td class="p-3">
            <span class="inline-flex items-center gap-1">
              <%= lucide_icon "file-text", class: "w-4 h-4 text-slate-500" %>
              <%= staff.records.count %>
            </span>
          </td>

          <td class="p-3">
            <div class="flex flex-wrap gap-3 items-center">
              <%= link_to operation_staff_path(staff),
                  class: "inline-flex items-center gap-1 text-green-700 font-semibold" do %>
                <%= lucide_icon "folder-open", class: "w-4 h-4" %>
                Open Folder
              <% end %>

              <%= link_to edit_operation_staff_path(staff),
                  class: "inline-flex items-center gap-1 text-blue-700 font-semibold" do %>
                <%= lucide_icon "pencil", class: "w-4 h-4" %>
                Edit
              <% end %>

              <%= button_to operation_staff_path(staff),
                  method: :delete,
                  form: { data: { turbo_confirm: "Archive this staff folder?" } },
                  class: "inline-flex items-center gap-1 text-red-600 font-semibold bg-transparent border-0 p-0 cursor-pointer" do %>
                <%= lucide_icon "archive", class: "w-4 h-4" %>
                Archive
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @operation_staffs.empty? %>
        <tr>
          <td colspan="5" class="p-6 text-center text-slate-500">
            No staff found.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>