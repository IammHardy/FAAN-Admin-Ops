<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">
      Operations Staff
    </h1>

    <p class="text-slate-500 mt-1">
      Staff folders and personal records.
    </p>
  </div>

  <%= link_to "Add Staff",
      new_operation_staff_path,
      class: "bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-800" %>
</div>

<div class="bg-white shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-100">
      <tr>
        <th class="text-left p-3">Staff</th>
        <th class="text-left p-3">Designation</th>
        <th class="text-left p-3">Unit</th>
        <th class="text-left p-3">Documents</th>
        <th class="text-left p-3"></th>
      </tr>
    </thead>

    <tbody>
      <% @operation_staffs.each do |staff| %>
        <tr class="border-t">
          <td class="p-3 font-medium">
            <%= staff.full_name %>
          </td>

          <td class="p-3">
            <%= staff.designation.presence || "—" %>
          </td>

          <td class="p-3">
            <%= staff.unit.presence || "—" %>
          </td>

          <td class="p-3">
            <%= staff.records.count %>
          </td>

          <td class="p-3">
            <%= link_to "Open Folder",
                operation_staff_path(staff),
                class: "text-green-700 font-semibold" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>