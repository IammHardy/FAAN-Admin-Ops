<%= form_with model: [:reports, @monthly_report], class: "space-y-5" do |f| %>
  <% if @monthly_report.errors.any? %>
    <div class="border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold mb-2">Please fix the following errors:</p>
      <ul class="list-disc ml-5 space-y-1">
        <% @monthly_report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Report Title", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :title, class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
  </div>

  <div>
    <%= f.label :report_month, "Report Month", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.date_field :report_month,
    class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
  </div>

  <% unless current_user.unit_officer? %>
    <div>
      <%= f.label :department_id, "Department", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :department_id, @departments, :id, :name,
          { prompt: "Select Department" },
          { class: "w-full border border-slate-300 px-3 py-2 text-sm" } %>
    </div>

    <div>
      <%= f.label :unit_id, "Unit", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :unit_id, @units, :id, :name,
          { prompt: "Select Unit" },
          { class: "w-full border border-slate-300 px-3 py-2 text-sm" } %>
    </div>
  <% end %>

  <div>
    <%= f.label :report_file, "Report File", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.file_field :report_file, class: "w-full border border-slate-300 px-3 py-2 text-sm bg-white" %>
    <p class="text-xs text-slate-500 mt-1">Upload PDF, DOC, DOCX, or image file.</p>
  </div>

  <div>
    <%= f.label :remarks, "Remarks", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :remarks, rows: 4, class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
  </div>

  <div class="flex items-center gap-3">
  <%= f.submit class: btn_primary %>

  <%= link_to "Cancel",
      reports_monthly_reports_path,
      class: btn_secondary %>
</div>
  </div>
<% end %>