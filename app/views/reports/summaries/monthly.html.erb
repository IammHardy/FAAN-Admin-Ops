<%= render "reports/nav" %>

<% content_for :page_title, "Monthly Summary" %>
<% content_for :page_subtitle, "Summary for #{@month_start.strftime('%B %Y')}" %>

<div class="bg-white border border-slate-200 shadow-sm p-4 mb-4">
  <%= form_with url: reports_monthly_summary_path, method: :get, local: true, class: "flex flex-wrap items-end gap-4" do %>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Month</label>
      <%= month_field_tag :month,
          params[:month] || @month_start.strftime("%Y-%m"),
          class: "border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div>
      <%= submit_tag "Load Summary", class: btn_primary %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Total Dispatches</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @dispatches.count %></h3>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Total Log Reports</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @log_reports.count %></h3>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Total Incidents</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @incidents.count %></h3>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <h3 class="text-base font-semibold text-slate-900 mb-4">Dispatch Status Breakdown</h3>

    <div class="space-y-3 text-sm">
      <% [
        ["Draft", @dispatches.select(&:draft?).count],
        ["Dispatched", @dispatches.select(&:dispatched?).count],
        ["Received", @dispatches.select(&:received?).count],
        ["Acknowledged", @dispatches.select(&:acknowledged?).count],
        ["Filed", @dispatches.select(&:filed?).count]
      ].each do |label, count| %>
        <div class="flex justify-between border-b border-slate-100 pb-2 last:border-b-0">
          <span class="text-slate-600"><%= label %></span>
          <span class="font-semibold text-slate-900"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <h3 class="text-base font-semibold text-slate-900 mb-4">Incident Severity Breakdown</h3>

    <div class="space-y-3 text-sm">
      <% [
        ["Low", @incidents.select(&:low?).count],
        ["Medium", @incidents.select(&:medium?).count],
        ["High", @incidents.select(&:high?).count],
        ["Critical", @incidents.select(&:critical?).count]
      ].each do |label, count| %>
        <div class="flex justify-between border-b border-slate-100 pb-2 last:border-b-0">
          <span class="text-slate-600"><%= label %></span>
          <span class="font-semibold text-slate-900"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6 bg-white border border-slate-200 shadow-sm p-5">
  <h3 class="text-base font-semibold text-slate-900 mb-4">Recent Incidents This Month</h3>

  <% if @incidents.any? %>
    <div class="space-y-3">
      <% @incidents.first(10).each do |incident| %>
        <div class="border-b border-slate-100 pb-3 last:border-b-0">
          <p class="font-medium">
            <%= link_to incident.incident_number,
                incident_path(incident),
                class: "text-green-700 hover:text-green-800" %>
          </p>

          <p class="text-sm text-slate-600">
            <%= incident.title %>
          </p>

          <p class="text-xs text-slate-500 mt-1">
            <%= incident.severity.humanize %>
            •
            <%= incident.status.humanize %>
            •
            <%= incident.created_at.strftime("%d %b %Y") %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-slate-500">
      No incidents recorded this month.
    </p>
  <% end %>
</div>