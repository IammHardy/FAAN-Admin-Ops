<%= render "reports/nav" %>

<% content_for :page_title, "Incident Reports" %>
<% content_for :page_subtitle, "Filter incidents by date, severity, type, and status." %>

<div class="bg-white border border-slate-200 shadow-sm p-4 mb-4">
  <%= form_with url: reports_incidents_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-6 gap-4" do %>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">From</label>
      <%= date_field_tag :from, params[:from], class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">To</label>
      <%= date_field_tag :to, params[:to], class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Severity</label>
      <%= select_tag :severity,
          options_for_select(Incident.severities.keys.map { |severity| [severity.humanize, severity] }, params[:severity]),
          include_blank: "All Severities",
          class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
      <%= select_tag :status,
          options_for_select(Incident.statuses.keys.map { |status| [status.humanize, status] }, params[:status]),
          include_blank: "All Statuses",
          class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Type</label>
      <%= select_tag :incident_type,
          options_for_select(Incident.incident_types.keys.map { |type| [type.humanize, type] }, params[:incident_type]),
          include_blank: "All Types",
          class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
    </div>

    <div class="flex items-end gap-2">
      <%= submit_tag "Filter", class: btn_primary %>
      <%= link_to "Reset", reports_incidents_path, class: btn_secondary %>
    </div>
  <% end %>
</div>

<div class="mt-4 mb-6 flex flex-wrap gap-2">
  <%= link_to "Export CSV",
      export_csv_reports_incidents_path(request.query_parameters),
      class: btn_secondary %>

  <%= link_to "Export PDF",
      export_pdf_reports_incidents_path(request.query_parameters),
      class: btn_secondary %>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Total Incidents</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @incidents.count %></h3>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Open / Under Review</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @incidents.count { |i| i.open? || i.under_review? } %></h3>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Escalated</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @incidents.select(&:escalated?).count %></h3>
  </div>

  <div class="bg-white border border-slate-200 shadow-sm p-5">
    <p class="text-sm text-slate-500">Resolved / Closed</p>
    <h3 class="text-2xl font-bold text-slate-900 mt-2"><%= @incidents.count { |i| i.resolved? || i.closed? } %></h3>
  </div>
</div>

<div class="bg-white border border-slate-200 shadow-sm overflow-x-auto">
  <% if @incidents.any? %>
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Incident No.</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Title</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Type</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Severity</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Status</th>
          <th class="text-left px-4 py-3 font-semibold text-slate-700">Created At</th>
          <th class="text-right px-4 py-3 font-semibold text-slate-700">View</th>
        </tr>
      </thead>

      <tbody>
        <% @incidents.each do |incident| %>
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="px-4 py-3 text-slate-700"><%= incident.incident_number %></td>
            <td class="px-4 py-3 font-medium text-slate-900"><%= incident.title %></td>
            <td class="px-4 py-3 text-slate-700"><%= incident.incident_type.humanize %></td>
            <td class="px-4 py-3 text-slate-700"><%= incident.severity.humanize %></td>
            <td class="px-4 py-3 text-slate-700"><%= incident.status.humanize %></td>
            <td class="px-4 py-3 text-slate-700"><%= incident.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Open", incident_path(incident), class: "text-green-700 hover:text-green-800 font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="p-6 text-sm text-slate-500">
      No incidents found for this filter.
    </div>
  <% end %>

  <div class="mt-6 px-4 pb-4">
    <%= paginate @incidents %>
  </div>
</div>