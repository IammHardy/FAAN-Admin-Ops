<% content_for :page_title, "Departments" %>
<% content_for :page_subtitle, "Manage airport departments." %>

<div class="flex items-center justify-between mb-4">
  <div></div>
  <%= link_to "New Department", new_department_path, class: btn_primary %>
</div>

<div class="bg-white border border-gray-200">
  <% if @departments.any? %>
    <div class="overflow-x-auto w-full">
      <table class="min-w-[800px] w-full text-sm whitespace-nowrap">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Name</th>
            <th class="text-left px-4 py-3 font-semibold">Description</th>
            <th class="text-left px-4 py-3 font-semibold">Status</th>
            <th class="text-right px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @departments.each do |department| %>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-3"><%= department.name %></td>

              <td class="px-4 py-3 text-gray-600">
                <%= department.description.presence || "-" %>
              </td>

              <td class="px-4 py-3">
                <span class="inline-block px-2 py-1 text-xs border <%= department.active? ? 'bg-green-50 border-green-300 text-green-700' : 'bg-red-50 border-red-300 text-red-700' %>">
                  <%= department.active? ? "Active" : "Inactive" %>
                </span>
              </td>

              <td class="px-4 py-3">
  <div class="flex items-center justify-end gap-2 flex-wrap">

    <%= link_to department_path(department),
        class: "inline-flex items-center gap-1 rounded-md bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 text-xs font-medium hover:bg-green-100 transition" do %>
      <%= lucide_icon "eye", class: "w-4 h-4" %>
      View
    <% end %>

    <%= link_to edit_department_path(department),
        class: "inline-flex items-center gap-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1.5 text-xs font-medium hover:bg-amber-100 transition" do %>
      <%= lucide_icon "pencil", class: "w-4 h-4" %>
      Edit
    <% end %>

    <%= button_to department_path(department),
        method: :delete,
        form: { class: "inline-block" },
        data: { turbo_confirm: "Are you sure you want to delete this department?" },
        class: "inline-flex items-center gap-1 rounded-md bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 text-xs font-medium hover:bg-red-100 transition cursor-pointer" do %>
      <%= lucide_icon "trash-2", class: "w-4 h-4" %>
      Delete
    <% end %>

  </div>
</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6 text-sm text-gray-500">
      No departments found.
    </div>
  <% end %>
</div>

<% if @departments.respond_to?(:total_pages) %>
  <div class="mt-6">
    <%= paginate @departments %>
  </div>
<% end %>