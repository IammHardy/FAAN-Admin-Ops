<div class="bg-white border border-gray-200">
  <% if @incidents.any? %>
    <div class="overflow-x-auto w-full">
      <table class="min-w-[900px] w-full text-sm whitespace-nowrap">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Incident No.</th>
            <th class="text-left px-4 py-3 font-semibold">Title</th>
            <th class="text-left px-4 py-3 font-semibold">Type</th>
            <th class="text-left px-4 py-3 font-semibold">Severity</th>
            <th class="text-left px-4 py-3 font-semibold">Status</th>
            <th class="text-left px-4 py-3 font-semibold">Created By</th>
            <th class="text-right px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @incidents.each do |incident| %>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-3 font-medium"><%= incident.incident_number %></td>
              <td class="px-4 py-3"><%= incident.title %></td>
              <td class="px-4 py-3"><%= incident.incident_type.humanize %></td>

              <td class="px-4 py-3">
                <span class="inline-flex items-center gap-1 px-2 py-1 text-xs border
                  <%= case incident.severity
                      when 'low'
                        'bg-gray-50 border-gray-300 text-gray-700'
                      when 'medium'
                        'bg-blue-50 border-blue-300 text-blue-700'
                      when 'high'
                        'bg-amber-50 border-amber-300 text-amber-700'
                      when 'critical'
                        'bg-red-50 border-red-300 text-red-700'
                      end %>">
                  <%= lucide_icon "triangle-alert", class: "w-3 h-3" %>
                  <%= incident.severity.humanize %>
                </span>
              </td>

              <td class="px-4 py-3">
                <span class="inline-flex items-center gap-1 text-slate-700">
                  <%= lucide_icon "circle", class: "w-3 h-3" %>
                  <%= incident.status.humanize %>
                </span>
              </td>

              <td class="px-4 py-3"><%= incident.created_by.display_name %></td>

              <td class="px-4 py-3">
                <div class="flex justify-end gap-3">
                  <%= link_to incident_path(incident),
                      class: "inline-flex items-center gap-1 text-green-700 hover:text-green-800 font-medium" do %>
                    <%= lucide_icon "eye", class: "w-4 h-4" %>
                    View
                  <% end %>

                  <% if can_create_incidents? %>
                    <%= link_to edit_incident_path(incident),
                        class: "inline-flex items-center gap-1 text-amber-600 hover:underline" do %>
                      <%= lucide_icon "pencil", class: "w-4 h-4" %>
                      Edit
                    <% end %>

                    <%= button_to incident_path(incident),
                        method: :delete,
                        form: { class: "inline-block", data: { turbo_confirm: "Are you sure you want to delete this incident?" } },
                        class: "inline-flex items-center gap-1 text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" do %>
                      <%= lucide_icon "trash-2", class: "w-4 h-4" %>
                      Delete
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6 text-sm text-gray-500 flex items-center gap-2">
      <%= lucide_icon "triangle-alert", class: "w-5 h-5 text-slate-400" %>
      No incidents found.
    </div>
  <% end %>
</div>