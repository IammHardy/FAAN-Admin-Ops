<div style="font-family: Arial, sans-serif; color:#0f172a; font-size:12px;">

  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
    <%= image_tag wicked_pdf_asset_base64("faan-logo.png"), style: "width:180px; height:auto;" %>

    <div style="text-align:right; font-size:11px; color:#475569;">
      <strong>Generated On</strong><br>
      <%= Time.current.strftime("%d %B %Y, %I:%M %p") %>
    </div>
  </div>

  <div style="text-align:center; margin-bottom:20px;">
    <h2 style="margin:0; font-size:17px; text-transform:uppercase;">
      Incident Report
    </h2>
    <p style="margin-top:6px; font-size:12px; color:#475569;">
      Operations Department - Admin Unit
    </p>
  </div>

  <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
    <tbody>
      <tr>
        <th style="text-align:left; width:25%; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Incident Number</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.incident_number %></td>
        <th style="text-align:left; width:20%; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Status</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.status.humanize %></td>
      </tr>

      <tr>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Title</th>
        <td colspan="3" style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.title %></td>
      </tr>

      <tr>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Incident Type</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.incident_type.humanize %></td>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Severity</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.severity.humanize %></td>
      </tr>

      <tr>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Created By</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.created_by.display_name %></td>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Reviewed By</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.reviewed_by&.display_name || "-" %></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-bottom:18px;">
    <h3 style="font-size:13px; margin-bottom:6px; color:#166534;">Description</h3>
    <div style="border:1px solid #cbd5e1; padding:10px; line-height:1.6;">
      <%= simple_format(@incident.description.presence || "-") %>
    </div>
  </div>

  <div style="margin-bottom:18px;">
    <h3 style="font-size:13px; margin-bottom:6px; color:#166534;">Action Taken</h3>
    <div style="border:1px solid #cbd5e1; padding:10px; line-height:1.6;">
      <%= simple_format(@incident.action_taken.presence || "-") %>
    </div>
  </div>

  <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
    <tbody>
      <tr>
        <th style="text-align:left; width:25%; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Escalation Required</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.escalation_required? ? "Yes" : "No" %></td>
        <th style="text-align:left; width:20%; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Escalated At</th>
        <td style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.escalated_at&.strftime("%d %b %Y, %I:%M %p") || "-" %></td>
      </tr>

      <tr>
        <th style="text-align:left; padding:8px; border:1px solid #cbd5e1; background:#f8fafc;">Escalated To</th>
        <td colspan="3" style="padding:8px; border:1px solid #cbd5e1;"><%= @incident.escalated_to.presence || "-" %></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-bottom:20px;">
    <h3 style="font-size:13px; margin-bottom:6px; color:#166534;">Reviewer Remark</h3>
    <div style="border:1px solid #cbd5e1; padding:10px; min-height:40px; line-height:1.6;">
      <%= simple_format(@incident.reviewer_remark.presence || "-") %>
    </div>
  </div>

  <div style="margin-top:30px; border-top:1px solid #cbd5e1; padding-top:10px; font-size:10px; color:#64748b; text-align:center;">
    Generated by FAAN Operations Admin System
  </div>
</div>