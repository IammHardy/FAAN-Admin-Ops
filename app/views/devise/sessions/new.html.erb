<div class="min-h-screen bg-slate-100 grid grid-cols-1 lg:grid-cols-2 [font-family:'Manrope',sans-serif]">
  <!-- Branding Section -->
  <div class="bg-white px-6 py-8 lg:px-12 lg:py-14 border-r border-slate-200">
    <div class="max-w-lg">
      <%= image_tag "faan-logo.png",
          class: "mb-8 object-contain",
          style: "width: 180px; max-width: 100%; height: auto;" %>

      <p class="text-sm lg:text-base text-slate-600 leading-7 max-w-md">
        Internal operations platform for dispatch tracking, daily log reports,
        incident management, monthly reports, minutes extraction, and accountability
        across departments and units.
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="border border-green-200 bg-green-50 px-5 py-4 rounded-lg">
          <h3 class="text-sm font-semibold text-green-900">Dispatch Tracking</h3>
          <p class="mt-1 text-sm text-green-800">
            Track internal memos and document movement across departments.
          </p>
        </div>

        <div class="border border-green-200 bg-green-50 px-5 py-4 rounded-lg">
          <h3 class="text-sm font-semibold text-green-900">Daily Log Reports</h3>
          <p class="mt-1 text-sm text-green-800">
            Capture and review operational logs by unit and shift.
          </p>
        </div>

        <div class="border border-green-200 bg-green-50 px-5 py-4 rounded-lg">
          <h3 class="text-sm font-semibold text-green-900">Incident Reporting</h3>
          <p class="mt-1 text-sm text-green-800">
            Extract incidents, escalate cases, and maintain accountability records.
          </p>
        </div>

        <div class="border border-green-200 bg-green-50 px-5 py-4 rounded-lg">
          <h3 class="text-sm font-semibold text-green-900">Monthly Reports</h3>
          <p class="mt-1 text-sm text-green-800">
            Submit and receive monthly reports digitally across departments and units.
          </p>
        </div>

        <div class="border border-green-200 bg-green-50 px-5 py-4 rounded-lg sm:col-span-2">
          <h3 class="text-sm font-semibold text-green-900">Minutes Assistance</h3>
          <p class="mt-1 text-sm text-green-800">
Speed up meeting documentation with assisted minutes drafting.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Login Section -->
<div class="flex items-center justify-center px-6 py-10">
  <div class="w-full max-w-md">
    <div class="bg-white border border-slate-200 shadow-lg rounded-xl px-6 md:px-8 py-8">
      
      <!-- Logo -->
      <div class="flex justify-center mb-5">
        <%= image_tag "faan-logo.png",
            class: "object-contain opacity-90",
            style: "width: 95px; max-width: 100%; height: auto;" %>
      </div>

      <div class="mb-8 text-center lg:text-left">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-900">
          Sign in
        </h2>

        <p class="mt-2 text-sm text-slate-600">
          Enter your credentials to access the FAAN Admin Operations System.
        </p>
      </div>

      <%= form_for(resource,
          as: resource_name,
          url: session_path(resource_name),
          html: { class: "space-y-5" }) do |f| %>

        <div>
          <%= f.label :email,
              class: "block text-sm font-medium text-slate-700 mb-1" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "w-full border border-slate-300 bg-white rounded-md px-3 py-2 text-sm text-slate-900 outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" %>
        </div>

        <div>
          <%= f.label :password,
              class: "block text-sm font-medium text-slate-700 mb-1" %>

          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "w-full border border-slate-300 bg-white rounded-md px-3 py-2 text-sm text-slate-900 outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me,
                class: "h-4 w-4 border border-slate-300 accent-green-700" %>

            <%= f.label :remember_me,
                class: "text-sm text-slate-600" %>
          </div>
        <% end %>

        <%= f.submit "Sign in",
            class: "w-full bg-green-700 hover:bg-green-800 text-white text-sm font-medium rounded-md px-4 py-2 transition" %>
      <% end %>

      <div class="mt-6 text-sm text-center lg:text-left">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
</div>