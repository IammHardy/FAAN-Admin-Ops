<%= turbo_frame_tag "log_entries_list" do %>
  <% if log_entries.any? %>
    <div class="space-y-4">
      <% log_entries.each do |entry| %>
        <div class="border border-gray-200 p-4">
          <p class="text-sm font-medium">
            <%= entry.entry_time&.strftime("%I:%M %p") || "-" %>
          </p>

          <p class="text-sm text-gray-800 mt-2">
            <%= entry.description %>
          </p>

          <p class="text-sm text-gray-600 mt-2">
            <strong>Action Taken:</strong> <%= entry.action_taken.presence || "-" %>
          </p>

          <div class="mt-3 flex flex-wrap gap-2">
  <%= link_to edit_log_report_log_entry_path(log_report, entry),
      class: "inline-flex items-center gap-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1.5 text-xs font-medium hover:bg-amber-100 transition" do %>
    <%= lucide_icon "pencil", class: "w-4 h-4" %>
    Edit
  <% end %>

  <% if can_manage_logs? && entry.incident_flag? && entry.incident.blank? %>
    <%= button_to create_incident_log_report_log_entry_path(log_report, entry),
        method: :post,
        data: { turbo_frame: "_top" },
        class: "inline-flex items-center gap-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1.5 text-xs font-medium hover:bg-blue-100 transition cursor-pointer" do %>
      <%= lucide_icon "triangle-alert", class: "w-4 h-4" %>
      Create Incident
    <% end %>

  <% elsif entry.incident.present? %>
    <%= link_to incident_path(entry.incident),
        data: { turbo_frame: "_top" },
        class: "inline-flex items-center gap-1 rounded-md bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 text-xs font-medium hover:bg-green-100 transition" do %>
      <%= lucide_icon "eye", class: "w-4 h-4" %>
      View Incident
    <% end %>
  <% end %>

  <%= button_to log_report_log_entry_path(log_report, entry),
      method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "inline-flex items-center gap-1 rounded-md bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 text-xs font-medium hover:bg-red-100 transition cursor-pointer" do %>
    <%= lucide_icon "trash-2", class: "w-4 h-4" %>
    Delete
  <% end %>
</div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">No log entries added yet.</p>
  <% end %>
<% end %>