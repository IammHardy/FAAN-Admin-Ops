<% content_for :page_title, "Daily Log Reports" %>
<% content_for :page_subtitle, "Manage daily logs submitted by departments and units." %>

<div class="flex items-center justify-between mb-4">
  <div></div>

  <% if can_manage_logs? %>
    <%= link_to "New Log Report", new_log_report_path, class: btn_primary %>
  <% end %>
</div>

<div class="bg-white border border-slate-200 shadow-sm">
  <% if @log_reports.any? %>
    <div class="overflow-x-auto w-full">
      <table class="min-w-[1000px] w-full text-sm whitespace-nowrap">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Date</th>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Shift</th>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Department</th>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Unit</th>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Entered By</th>
            <th class="text-left px-4 py-3 font-semibold text-slate-700">Status</th>
            <th class="text-right px-4 py-3 font-semibold text-slate-700">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @log_reports.each do |log_report| %>
            <tr class="border-b border-slate-100 hover:bg-slate-50">
              <td class="px-4 py-3 text-slate-700"><%= log_report.report_date&.strftime("%d %b %Y") %></td>
              <td class="px-4 py-3 text-slate-700"><%= log_report.shift.humanize %></td>
              <td class="px-4 py-3 text-slate-700"><%= log_report.department.name %></td>
              <td class="px-4 py-3 text-slate-700"><%= log_report.unit.name %></td>
              <td class="px-4 py-3 text-slate-700"><%= log_report.entered_by.display_name %></td>

              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium border
                  <%= case log_report.status
                      when 'draft'
                        'bg-slate-50 border-slate-300 text-slate-700'
                      when 'submitted'
                        'bg-amber-50 border-amber-200 text-amber-700'
                      when 'reviewed'
                        'bg-green-50 border-green-200 text-green-700'
                      else
                        'bg-slate-50 border-slate-300 text-slate-700'
                      end %>">
                  <%= log_report.status.humanize %>
                </span>
              </td>

              <td class="px-4 py-3">
  <div class="flex items-center justify-end gap-2 flex-wrap">
    <%= link_to "View",
        log_report_path(log_report),
        class: "inline-flex items-center rounded-md bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 text-xs font-medium hover:bg-green-100 transition" %>

    <% if current_user.reviewer? && log_report.submitted? %>
      <%= link_to "Review",
          review_log_report_path(log_report),
          data: {
            turbo_method: :patch,
            turbo_confirm: "Mark this log report as reviewed?"
          },
          class: "inline-flex items-center rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 text-xs font-medium hover:bg-emerald-100 transition" %>
    <% end %>

    <%= link_to "Print",
        print_log_report_path(log_report),
        target: "_blank",
        class: "inline-flex items-center rounded-md bg-slate-50 text-slate-700 border border-slate-200 px-3 py-1.5 text-xs font-medium hover:bg-slate-100 transition" %>

    <% if can_manage_logs? %>
      <%= link_to "Edit",
          edit_log_report_path(log_report),
          class: "inline-flex items-center rounded-md bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1.5 text-xs font-medium hover:bg-amber-100 transition" %>
    <% end %>

    <% if can_delete_logs? %>
      <%= button_to "Delete",
          log_report_path(log_report),
          method: :delete,
          form: { class: "inline-block" },
          data: {
            turbo_confirm: "Are you sure you want to delete this log report?"
          },
          class: "inline-flex items-center rounded-md bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 text-xs font-medium hover:bg-red-100 transition cursor-pointer" %>
    <% end %>
  </div>
</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6 text-sm text-slate-500">
      No log reports found.
    </div>
  <% end %>
</div>

<% if @log_reports.respond_to?(:total_pages) %>
  <div class="mt-6 px-4 pb-4">
    <%= paginate @log_reports %>
  </div>
<% end %>