<div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
  <div class="bg-slate-100 px-5 py-3 border-b">
    <h2 class="font-semibold text-slate-900 flex items-center gap-2">
      <%= lucide_icon icon, class: "w-5 h-5 text-green-700" %>

      <span>
        <%= title %>
        <span class="text-sm font-normal text-slate-500">
          (<%= items.count %>)
        </span>
      </span>
    </h2>
  </div>

  <% if items.any? %>
    <div class="divide-y divide-slate-100">
      <% items.each do |item| %>
        <div class="px-5 py-4 flex justify-between gap-4">
          <div>
            <p class="font-medium text-slate-900">
              <% if item.respond_to?(:full_name) %>
                <%= item.full_name %>
              <% elsif item.respond_to?(:reference_number) && item.reference_number.present? %>
                <%= item.reference_number %> — <%= item.try(:subject) || item.try(:title) %>
              <% elsif item.respond_to?(:incident_number) && item.incident_number.present? %>
                <%= item.incident_number %> — <%= item.title %>
              <% else %>
                <%= item.try(:title) || item.try(:subject) || "Untitled" %>
              <% end %>
            </p>

            <p class="text-sm text-slate-500">
              <%= item.class.name %>
            </p>
          </div>

          <%= link_to send(path_method, item),
              class: "inline-flex items-center gap-1 text-green-700 font-medium text-sm" do %>
            <%= lucide_icon "eye", class: "w-4 h-4" %>
            View
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-5 py-4 text-sm text-slate-500 flex items-center gap-2">
      <%= lucide_icon "search-x", class: "w-5 h-5 text-slate-400" %>
      No results found.
    </div>
  <% end %>
</div>