<% content_for :page_title, "Users" %>
<% content_for :page_subtitle, "Manage system users and roles." %>

<div class="flex items-center justify-between mb-4">
  <div></div>

  <%= link_to new_user_path,
      class: "#{btn_primary} inline-flex items-center gap-2" do %>
    <%= lucide_icon "user-plus", class: "w-4 h-4" %>
    New User
  <% end %>
</div>

<div class="bg-white border border-gray-200">
  <% if @users.any? %>
    <div class="overflow-x-auto w-full">
      <table class="min-w-[1000px] w-full text-sm whitespace-nowrap">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Full Name</th>
            <th class="text-left px-4 py-3 font-semibold">Email</th>
            <th class="text-left px-4 py-3 font-semibold">Role</th>
            <th class="text-left px-4 py-3 font-semibold">Department</th>
            <th class="text-left px-4 py-3 font-semibold">Unit</th>
            <th class="text-left px-4 py-3 font-semibold">Status</th>
            <th class="text-right px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-3"><%= user.full_name %></td>
              <td class="px-4 py-3 text-gray-600"><%= user.email %></td>
              <td class="px-4 py-3"><%= user.role.humanize %></td>
              <td class="px-4 py-3"><%= user.department&.name || "-" %></td>
              <td class="px-4 py-3"><%= user.unit&.name || "-" %></td>

              <td class="px-4 py-3">
                <span class="inline-flex items-center gap-1 px-2 py-1 text-xs border <%= user.active? ? 'bg-green-50 border-green-300 text-green-700' : 'bg-red-50 border-red-300 text-red-700' %>">
                  <%= lucide_icon(user.active? ? "circle-check" : "circle-x", class: "w-3 h-3") %>
                  <%= user.active? ? "Active" : "Inactive" %>
                </span>
              </td>

              <td class="px-4 py-3">
                <div class="flex justify-end gap-3">
                  <%= link_to user_path(user),
                      class: "inline-flex items-center gap-1 text-green-700 hover:text-green-800 font-medium" do %>
                    <%= lucide_icon "eye", class: "w-4 h-4" %>
                    View
                  <% end %>

                  <%= link_to edit_user_path(user),
                      class: "inline-flex items-center gap-1 text-slate-600 hover:text-slate-900 font-medium" do %>
                    <%= lucide_icon "pencil", class: "w-4 h-4" %>
                    Edit
                  <% end %>

                  <%= button_to user_path(user),
                      method: :delete,
                      form: { class: "inline-block", data: { turbo_confirm: "Are you sure you want to deactivate this user?" } },
                      class: "inline-flex items-center gap-1 text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" do %>
                    <%= lucide_icon "user-x", class: "w-4 h-4" %>
                    Deactivate
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6 text-sm text-gray-500 flex items-center gap-2">
      <%= lucide_icon "users", class: "w-5 h-5 text-slate-400" %>
      No users found.
    </div>
  <% end %>
</div>

<% if @users.respond_to?(:total_pages) %>
  <div class="mt-6">
    <%= paginate @users %>
  </div>
<% end %>