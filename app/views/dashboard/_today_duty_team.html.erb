<div class="bg-white border border-slate-200 shadow-sm rounded-xl p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-lg font-semibold text-slate-900">
        Today's Admin Office Duty Team
      </h2>

      <p class="text-sm text-slate-500 mt-1">
        Staff available in Admin Office today.
      </p>
    </div>

    <div class="text-sm text-slate-500">
      <%= Date.current.strftime("%A, %d %B %Y") %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <div class="rounded-xl border border-slate-200 p-4 bg-slate-50">
      <h3 class="font-semibold text-slate-800 mb-3">
        Always Present
      </h3>

      <% if @always_present_staff.any? %>
        <div class="space-y-2">
          <% @always_present_staff.each do |staff| %>
            <div class="flex justify-between items-center text-sm">
              <span class="font-medium text-slate-800">
                <%= staff.full_name %>
              </span>

              <% if staff.designation.present? %>
                <span class="text-slate-500">
                  <%= staff.designation %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">
          No always-present staff configured.
        </p>
      <% end %>
    </div>

    <div class="rounded-xl border border-green-200 p-4 bg-green-50">
      <h3 class="font-semibold text-slate-800 mb-3">
        On Duty Today
      </h3>

      <% if @today_admin_rosters.any? %>
        <div class="space-y-2">
          <% @today_admin_rosters.each do |roster| %>
            <div class="flex justify-between items-center text-sm">
              <span class="font-medium text-slate-800">
                <%= roster.operation_staff.full_name %>
              </span>

              <% if roster.operation_staff.designation.present? %>
                <span class="text-slate-500">
                  <%= roster.operation_staff.designation %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">
          No Admin Office duty roster for today.
        </p>
      <% end %>
    </div>

  </div>
</div>