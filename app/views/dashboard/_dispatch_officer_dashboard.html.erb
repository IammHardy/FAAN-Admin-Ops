<% content_for :page_title, "Dispatch Officer Dashboard" %>
<% content_for :page_subtitle, "Create, send, and track official memos." %>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="app-stat-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="app-stat-label">Dispatches Today</p>
        <h3 class="app-stat-value"><%= @dispatches_today %></h3>
      </div>
      <%= lucide_icon "send", class: "w-8 h-8 text-green-700" %>
    </div>
  </div>

  <div class="app-stat-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="app-stat-label">Draft Dispatches</p>
        <h3 class="app-stat-value"><%= @draft_dispatches.count %></h3>
      </div>
      <%= lucide_icon "file-pen-line", class: "w-8 h-8 text-slate-500" %>
    </div>
  </div>

  <div class="app-stat-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="app-stat-label">Pending Acknowledgement</p>
        <h3 class="app-stat-value"><%= @pending_acknowledgement_count %></h3>
      </div>
      <%= lucide_icon "clock", class: "w-8 h-8 text-amber-600" %>
    </div>
  </div>
</div>

<div class="app-card mb-6">
  <div class="app-card-body">
    <div class="flex items-center justify-between mb-4">
      <h3 class="app-section-title flex items-center gap-2">
        <%= lucide_icon "zap", class: "w-5 h-5 text-green-700" %>
        Quick Actions
      </h3>
    </div>

    <%= link_to new_dispatch_path, class: btn_primary do %>
      <span class="inline-flex items-center gap-2">
        <%= lucide_icon "plus", class: "w-4 h-4" %>
        Create New Dispatch
      </span>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="app-card">
    <div class="app-card-body">
      <h3 class="app-section-title mb-4 flex items-center gap-2">
        <%= lucide_icon "file-pen-line", class: "w-5 h-5 text-slate-600" %>
        Draft Dispatches
      </h3>

      <% if @draft_dispatches.any? %>
        <div class="space-y-3">
          <% @draft_dispatches.each do |dispatch| %>
            <div class="border-b border-slate-100 pb-3 last:border-b-0">
              <p class="font-medium">
                <%= link_to dispatch.reference_number, dispatch_path(dispatch), class: "text-green-700 hover:text-green-800 font-medium" %>
              </p>
              <p class="text-sm text-slate-600"><%= dispatch.subject %></p>
              <p class="text-xs text-slate-500 mt-1"><%= dispatch.memo_date&.strftime("%d %b %Y") %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="app-muted">No draft dispatches.</p>
      <% end %>
    </div>
  </div>

  <div class="app-card">
    <div class="app-card-body">
      <h3 class="app-section-title mb-4 flex items-center gap-2">
        <%= lucide_icon "send-horizontal", class: "w-5 h-5 text-green-700" %>
        Recently Dispatched
      </h3>

      <% if @dispatched_dispatches.any? %>
        <div class="space-y-3">
          <% @dispatched_dispatches.each do |dispatch| %>
            <div class="border-b border-slate-100 pb-3 last:border-b-0">
              <p class="font-medium">
                <%= link_to dispatch.reference_number, dispatch_path(dispatch), class: "text-green-700 hover:text-green-800 font-medium" %>
              </p>
              <p class="text-sm text-slate-600"><%= dispatch.subject %></p>
              <p class="text-xs text-slate-500 mt-1"><%= dispatch.memo_date&.strftime("%d %b %Y") %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="app-muted">No dispatched memos yet.</p>
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
  <div class="app-stat-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="app-stat-label">Monthly Reports</p>
        <h3 class="app-stat-value"><%= @monthly_reports_count %></h3>
      </div>
      <%= lucide_icon "file-bar-chart", class: "w-8 h-8 text-slate-500" %>
    </div>
  </div>

  <div class="app-stat-card">
    <div class="flex items-center justify-between">
      <div>
        <p class="app-stat-label">Pending Monthly Reviews</p>
        <h3 class="app-stat-value"><%= @pending_monthly_reviews_count %></h3>
      </div>
      <%= lucide_icon "hourglass", class: "w-8 h-8 text-amber-600" %>
    </div>
  </div>
</div>

<div class="app-card mt-6">
  <div class="app-card-body">
    <h3 class="app-section-title mb-4 flex items-center gap-2">
      <%= lucide_icon "archive", class: "w-5 h-5 text-green-700" %>
      Ready to File
    </h3>

    <% if @ready_to_file_dispatches.any? %>
      <div class="space-y-3">
        <% @ready_to_file_dispatches.each do |dispatch| %>
          <div class="border-b border-slate-100 pb-3 last:border-b-0">
            <p class="font-medium">
              <%= link_to dispatch.reference_number, dispatch_path(dispatch), class: "text-green-700 hover:text-green-800 font-medium" %>
            </p>
            <p class="text-sm text-slate-600"><%= dispatch.subject %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="app-muted">No dispatches ready to file.</p>
    <% end %>
  </div>
</div>