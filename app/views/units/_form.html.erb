<%= form_with model: @unit, class: "space-y-5" do |f| %>
  <% if @unit.errors.any? %>
    <div class="border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold mb-2">Please fix the following errors:</p>
      <ul class="list-disc ml-5 space-y-1">
        <% @unit.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :department_id, "Department", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.collection_select :department_id, @departments, :id, :name,
        { prompt: "Select Department" },
        { class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" } %>
  </div>

  <div>
    <%= f.label :name, "Unit Name", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full border border-slate-300 px-3 py-2 text-sm focus:border-green-700 focus:ring-green-700" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "border-slate-300 text-green-700 focus:ring-green-700" %>
    <%= f.label :active, "Active", class: "text-sm font-medium text-slate-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: btn_primary %>
    <%= link_to "Cancel", units_path, class: btn_secondary %>
  </div>
<% end %>