<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= content_for?(:page_title) ? "#{yield(:page_title)} | FAAN Admin Ops" : "FAAN Admin Ops" %>
    </title>

    <%= favicon_link_tag "favicon.png", type: "image/png" %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      .app-shell { min-height: 100vh; }

      .app-sidebar {
        position: relative;
        width: 100%;
        max-height: 0;
        overflow: hidden;
        z-index: 40;
        transition: max-height 0.3s ease;
      }

      .app-sidebar.open {
        max-height: 80vh;
        overflow-y: auto;
      }

      @media (min-width: 768px) {
        .app-shell { display: flex; }

        .app-sidebar {
          position: sticky;
          top: 0;
          width: 18rem;
          height: 100vh;
          max-height: none;
          overflow-y: auto;
          flex-shrink: 0;
        }

        .app-content { flex: 1; }

        #sidebar-open,
        #sidebar-overlay,
        #sidebar-close {
          display: none !important;
        }
      }
    </style>
  </head>

  <body
  class="bg-slate-50 text-slate-900 min-h-screen antialiased"
  style="font-family: 'Manrope', sans-serif;">
    <div class="app-shell">
      <% if user_signed_in? %>
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden"></div>

        <aside id="sidebar" class="app-sidebar bg-white text-slate-900 border-r border-slate-200 flex flex-col">
          <div class="px-5 py-4 border-b border-slate-200">
  <div class="flex flex-col items-center text-center">

    <%= image_tag "faan-logo.png",
        class: "w-48 object-contain" %>

    <p class="text-[11px] text-slate-400 mt-2 uppercase tracking-[0.12em]">
      Abuja Station
    </p>

    <p class="text-xs text-green-700 font-medium mt-1">
      Operations Admin
    </p>

  </div>

            <button
              type="button"
              id="sidebar-close"
              class="md:hidden mt-4 w-full border border-slate-300 px-2 py-2 text-sm hover:bg-slate-50">
              Close Menu
            </button>
          </div>
<nav class="flex-1 px-4 py-3 space-y-1 text-sm overflow-y-auto">

  <%= link_to dashboard_path,
      class: nav_link_class(dashboard_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("layout-dashboard") %>
      Dashboard
    </div>
  <% end %>

  <% if current_user.super_admin? %>
    <div class="border-t border-slate-200 my-3"></div>

    <p class="px-4 text-[11px] uppercase tracking-wide text-slate-400">
      System Administration
    </p>

    <%= link_to departments_path, class: nav_link_class(departments_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("building-2") %>
        Departments
      </div>
    <% end %>

    <%= link_to units_path, class: nav_link_class(units_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("blocks") %>
        Units
      </div>
    <% end %>

    <%= link_to users_path, class: nav_link_class(users_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("users") %>
        Users
      </div>
    <% end %>

    <%= link_to duty_rosters_path, class: nav_link_class(duty_rosters_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("calendar-days") %>
        Duty Roster
      </div>
    <% end %>

    <%= link_to audit_logs_path, class: nav_link_class(audit_logs_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("shield-check") %>
        Audit Logs
      </div>
    <% end %>
  <% end %>

  <div class="border-t border-slate-200 my-3"></div>

  <p class="px-4 text-[11px] uppercase tracking-wide text-slate-400">
    Records & Dispatch
  </p>

  <%= link_to dispatches_path, class: nav_link_class(dispatches_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("send") %>
      Dispatch Register
    </div>
  <% end %>
<%= link_to new_dispatch_path, class: nav_link_class(new_dispatch_path) do %>
  <div class="flex items-center gap-3">
  <%= nav_icon("plus-circle") %>
  Create Dispatch
  </div>
<% end %>

  <%= link_to operation_staffs_path, class: nav_link_class(operation_staffs_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("folder-kanban") %>
      Operations Staff
    </div>
  <% end %>

  <%= link_to records_path, class: nav_link_class(records_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("archive") %>
      Records Archive
    </div>
  <% end %>

  <%= link_to daily_filing_log_path, class: nav_link_class(daily_filing_log_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("file-stack") %>
      Daily Filing Log
    </div>
  <% end %>

  <%= link_to log_reports_path, class: nav_link_class(log_reports_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("clipboard-list") %>
      Daily Logs
    </div>
  <% end %>

  <%= link_to incidents_path, class: nav_link_class(incidents_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("triangle-alert") %>
      Incidents
    </div>
  <% end %>

  <%= link_to reports_monthly_reports_path,
      class: nav_link_class(reports_monthly_reports_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("file-bar-chart") %>
      Monthly Reports
    </div>
  <% end %>

  <% if current_user.super_admin? || current_user.admin_officer? %>
    <%= link_to minutes_path, class: nav_link_class(minutes_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("mic") %>
        Minutes Extraction
      </div>
    <% end %>
  <% end %>

  <%= link_to global_search_path,
      class: nav_link_class(global_search_path) do %>
    <div class="flex items-center gap-3">
      <%= nav_icon("search") %>
      Global Search
    </div>
  <% end %>

  <% unread_count = current_user.notifications.unread.count %>

  <%= link_to notifications_path,
      class: "relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-green-50 hover:text-green-800 rounded-lg" do %>

    <%= nav_icon("bell") %>
    Notifications

    <% if unread_count.positive? %>
      <span class="absolute top-2 right-3 bg-red-600 text-white text-xs rounded-full px-1.5 py-0.5">
        <%= unread_count %>
      </span>
    <% end %>
  <% end %>

  <% if current_user.super_admin? %>
    <div class="border-t border-slate-200 my-3"></div>

    <%= link_to archived_operation_staffs_path,
        class: nav_link_class(archived_operation_staffs_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("folder-x") %>
        Archived Staff
      </div>
    <% end %>

    <%= link_to deleted_records_path,
        class: nav_link_class(deleted_records_path) do %>
      <div class="flex items-center gap-3">
        <%= nav_icon("trash-2") %>
        Deleted Records
      </div>
    <% end %>
  <% end %>

</nav>

          <div class="px-4 py-3 border-t border-slate-200">
            <%= link_to "My Account",
                edit_account_path,
                class: "block w-full text-center border border-slate-300 text-green-800 px-4 py-2 text-sm font-medium hover:bg-green-50" %>
          </div>

          <div class="px-4 py-4 border-t border-slate-200 text-sm">
            <p class="font-semibold text-slate-900"><%= current_user.display_name %></p>
            <p class="text-slate-500 capitalize"><%= current_user.role.humanize %></p>

            <div class="mt-4">
              <%= button_to "Sign Out",
                  destroy_user_session_path,
                  method: :delete,
                  class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-sm font-medium" %>
            </div>
          </div>
        </aside>
      <% end %>

      <div class="app-content">
        <% if user_signed_in? %>
          <header class="bg-white border-b border-slate-200 px-4 md:px-6 py-4 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-lg md:text-xl font-semibold text-slate-900">
                <%= content_for?(:page_title) ? yield(:page_title) : "FAAN Admin Operations System" %>
              </h2>

              <% if content_for?(:page_subtitle) %>
                <p class="text-sm text-slate-500 mt-1"><%= yield(:page_subtitle) %></p>
              <% end %>
            </div>

           
<div class="flex items-center gap-2 flex-wrap">
  <% unread_notifications_count = current_user.notifications.unread.count %>

  <% if current_user&.duty_session_required? %>
    <% if current_duty_session.present? %>

      <div class="flex items-center gap-2 border border-green-200 bg-green-50 px-3 py-2 rounded-lg">
        <%= lucide_icon "circle-check", class: "w-4 h-4 text-green-700" %>
<span class="text-sm text-green-700 font-medium">
  On Duty:
  <%= current_duty_officer.full_name %>
</span>
      </div>

      <%= button_to "End Duty",
          end_current_duty_sessions_path,
          method: :patch,
          class: "text-sm border border-red-300 bg-white text-red-700 px-3 py-2 rounded-lg hover:bg-red-50" %>

    <% else %>

      <%= link_to "Start Duty",
          new_duty_session_path,
          class: "text-sm bg-green-700 text-white px-3 py-2 rounded-lg hover:bg-green-800" %>

    <% end %>
  <% end %>

  <%= link_to notifications_path,
      class: "relative text-sm border border-slate-300 px-3 py-2 rounded-lg bg-white hover:bg-slate-50" do %>
    <%= lucide_icon "bell", class: "w-4 h-4" %>

    <% if unread_notifications_count.positive? %>
      <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs px-1.5 py-0.5 rounded-full">
        <%= unread_notifications_count %>
      </span>
    <% end %>
  <% end %>

  <button
    type="button"
    id="sidebar-open"
    class="md:hidden inline-flex items-center justify-center border border-slate-300 px-3 py-2 text-sm bg-white hover:bg-slate-100 rounded-lg">
    <%= lucide_icon "menu", class: "w-5 h-5" %>
  </button>
</div>


          </header>
        <% end %>

        <main class="px-4 md:px-6 py-6">
          <% flash.each do |type, message| %>
            <div class="<%= flash_class(type) %> mb-4 px-4 py-3 border text-sm">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <script>
      function setupSidebarMenu() {
        const sidebar = document.getElementById("sidebar");
        const openButton = document.getElementById("sidebar-open");
        const closeButton = document.getElementById("sidebar-close");
        const overlay = document.getElementById("sidebar-overlay");

        if (!sidebar || !openButton || !closeButton || !overlay) return;

        function openSidebar() {
          sidebar.classList.add("open");
          overlay.classList.remove("hidden");
        }

        function closeSidebar() {
          sidebar.classList.remove("open");
          overlay.classList.add("hidden");
        }

        openButton.onclick = openSidebar;
        closeButton.onclick = closeSidebar;
        overlay.onclick = closeSidebar;

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") closeSidebar();
        });

        window.addEventListener("resize", function () {
          if (window.innerWidth >= 768) closeSidebar();
        });
      }

      document.addEventListener("DOMContentLoaded", setupSidebarMenu);
      document.addEventListener("turbo:load", setupSidebarMenu);
    </script>
  </body>
</html>