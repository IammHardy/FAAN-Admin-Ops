<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= content_for?(:page_title) ? "#{yield(:page_title)} | FAAN Admin Ops" : "FAAN Admin Ops" %>
    </title>

    <%= favicon_link_tag "favicon.png", type: "image/png" %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      .app-shell { min-height: 100vh; }

      .app-sidebar {
        position: relative;
        width: 100%;
        max-height: 0;
        overflow: hidden;
        z-index: 40;
        transition: max-height 0.3s ease;
      }

      .app-sidebar.open {
        max-height: 80vh;
        overflow-y: auto;
      }

      @media (min-width: 768px) {
        .app-shell { display: flex; }

        .app-sidebar {
          position: sticky;
          top: 0;
          width: 18rem;
          height: 100vh;
          max-height: none;
          overflow-y: auto;
          flex-shrink: 0;
        }

        .app-content { flex: 1; }

        #sidebar-open,
        #sidebar-overlay,
        #sidebar-close {
          display: none !important;
        }
      }
    </style>
  </head>

  <body
  class="bg-slate-50 text-slate-900 min-h-screen antialiased"
  style="font-family: 'Manrope', sans-serif;">
    <div class="app-shell">
      <% if user_signed_in? %>
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden"></div>

        <aside id="sidebar" class="app-sidebar bg-white text-slate-900 border-r border-slate-200 flex flex-col">
          <div class="px-5 py-4 border-b border-slate-200">
  <div class="flex flex-col items-center text-center">

    <%= image_tag "faan-logo.png",
        class: "w-48 object-contain" %>

    <p class="text-[11px] text-slate-400 mt-2 uppercase tracking-[0.12em]">
      Abuja Station
    </p>

    <p class="text-xs text-green-700 font-medium mt-1">
      Operations Admin
    </p>

  </div>

            <button
              type="button"
              id="sidebar-close"
              class="md:hidden mt-4 w-full border border-slate-300 px-2 py-2 text-sm hover:bg-slate-50">
              Close Menu
            </button>
          </div>
<nav class="flex-1 px-4 py-3 space-y-1 text-sm overflow-y-auto">
  <%= link_to "Dashboard", dashboard_path, class: nav_link_class(dashboard_path) %>

  <% if current_user.super_admin? %>
    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      System Administration
    </p>

    <%= link_to "Departments", departments_path, class: nav_link_class(departments_path) %>
    <%= link_to "Units", units_path, class: nav_link_class(units_path) %>
    <%= link_to "Users", users_path, class: nav_link_class(users_path) %>
    <%= link_to "Duty Roster", duty_rosters_path, class: nav_link_class(duty_rosters_path) %>
    <%= link_to "Audit Logs", audit_logs_path, class: nav_link_class(audit_logs_path) %>
  <% end %>

  <% if current_user.unit_officer? %>
    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      Unit Office
    </p>

    <%= link_to "Incoming Memos", incoming_dispatches_path, class: nav_link_class(incoming_dispatches_path) %>
  <% end %>

  <% if current_user.super_admin? || current_user.admin_officer? || current_user.unit_officer? || current_user.reviewer? %>
    <%= link_to "Daily Logs", log_reports_path, class: nav_link_class(log_reports_path) %>
  <% end %>

  <% if current_user.dispatch_officer? || current_user.admin_officer? || current_user.super_admin? %>
    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      Dispatch
    </p>

    <%= link_to "Dispatch Register", dispatches_path, class: nav_link_class(dispatches_path) %>
    <%= link_to "New Dispatch", new_dispatch_path, class: nav_link_class(new_dispatch_path) %>
    <%= link_to "Pending Acknowledgements", pending_acknowledgement_dispatches_path, class: nav_link_class(pending_acknowledgement_dispatches_path) %>
    <%= link_to "Ready to File", ready_to_file_dispatches_path, class: nav_link_class(ready_to_file_dispatches_path) %>
    <%= link_to "Filed Dispatches", filed_dispatches_path, class: nav_link_class(filed_dispatches_path) %>

    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      Records Archive
    </p>

    <%= link_to "Operations Staff", operation_staffs_path, class: nav_link_class(operation_staffs_path) %>
    <%= link_to "Records Archive", records_path, class: nav_link_class(records_path) %>
    <%= link_to "Add Record", new_record_path, class: nav_link_class(new_record_path) %>
    <%= link_to "Daily Filing Log", daily_filing_log_path, class: nav_link_class(daily_filing_log_path) %>
  <% end %>

  <% if current_user.super_admin? || current_user.admin_officer? || current_user.reviewer? %>
    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      Reviews & Reports
    </p>

    <%= link_to "Incidents", incidents_path, class: nav_link_class(incidents_path) %>
    <%= link_to "Reports", reports_dispatches_path, class: nav_link_class(reports_dispatches_path) %>
  <% end %>

  <% if current_user.super_admin? || current_user.admin_officer? %>
    <%= link_to "Minutes Extraction", minutes_path, class: nav_link_class(minutes_path) %>
  <% end %>

  <%= link_to "Monthly Reports",
      reports_monthly_reports_path,
      class: nav_link_class(reports_monthly_reports_path) %>

  <% unread_count = current_user.notifications.unread.count %>

  <%= link_to notifications_path,
      class: "relative flex items-center px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-green-50 hover:text-green-800" do %>
    🔔 Notifications

    <% if unread_count.positive? %>
      <span class="absolute top-2 right-3 bg-red-600 text-white text-xs rounded-full px-1.5 py-0.5">
        <%= unread_count %>
      </span>
    <% end %>
  <% end %>
  <% if current_user.super_admin? || current_user.admin_officer? || current_user.reviewer? %>
    <div class="border-t border-slate-200 my-2"></div>

    <p class="px-4 pt-2 pb-1 text-[11px] uppercase tracking-wide text-slate-400">
      Global Search
      <%= link_to "Global Search", global_search_path, class: nav_link_class(global_search_path) %>
    </p>
    <% end %>

  <% if current_user.super_admin? %>
  <%= link_to "Archived Staff", archived_operation_staffs_path, class: nav_link_class(archived_operation_staffs_path) %>
  <%= link_to "Deleted Records", deleted_records_path, class: nav_link_class(deleted_records_path) %>
<% end %>
</nav>

          <div class="px-4 py-3 border-t border-slate-200">
            <%= link_to "My Account",
                edit_account_path,
                class: "block w-full text-center border border-slate-300 text-green-800 px-4 py-2 text-sm font-medium hover:bg-green-50" %>
          </div>

          <div class="px-4 py-4 border-t border-slate-200 text-sm">
            <p class="font-semibold text-slate-900"><%= current_user.display_name %></p>
            <p class="text-slate-500 capitalize"><%= current_user.role.humanize %></p>

            <div class="mt-4">
              <%= button_to "Sign Out",
                  destroy_user_session_path,
                  method: :delete,
                  class: "w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-sm font-medium" %>
            </div>
          </div>
        </aside>
      <% end %>

      <div class="app-content">
        <% if user_signed_in? %>
          <header class="bg-white border-b border-slate-200 px-4 md:px-6 py-4 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-lg md:text-xl font-semibold text-slate-900">
                <%= content_for?(:page_title) ? yield(:page_title) : "FAAN Admin Operations System" %>
              </h2>

              <% if content_for?(:page_subtitle) %>
                <p class="text-sm text-slate-500 mt-1"><%= yield(:page_subtitle) %></p>
              <% end %>
            </div>

           
<div class="flex items-center gap-2 flex-wrap">
  <% unread_notifications_count = current_user.notifications.unread.count %>

  <% if current_user&.duty_session_required? %>
    <% if current_duty_session.present? %>

      <div class="flex items-center gap-2 border border-green-200 bg-green-50 px-3 py-2 rounded-lg">
        <span class="text-sm text-green-700 font-medium">
          🟢 On Duty:
          <%= current_duty_officer.full_name %>
        </span>
      </div>

      <%= button_to "End Duty",
          end_current_duty_sessions_path,
          method: :patch,
          class: "text-sm border border-red-300 bg-white text-red-700 px-3 py-2 rounded-lg hover:bg-red-50" %>

    <% else %>

      <%= link_to "Start Duty",
          new_duty_session_path,
          class: "text-sm bg-green-700 text-white px-3 py-2 rounded-lg hover:bg-green-800" %>

    <% end %>
  <% end %>

  <%= link_to notifications_path,
      class: "relative text-sm border border-slate-300 px-3 py-2 rounded-lg bg-white hover:bg-slate-50" do %>
    🔔

    <% if unread_notifications_count.positive? %>
      <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs px-1.5 py-0.5 rounded-full">
        <%= unread_notifications_count %>
      </span>
    <% end %>
  <% end %>

  <button
    type="button"
    id="sidebar-open"
    class="md:hidden inline-flex items-center justify-center border border-slate-300 px-3 py-2 text-sm bg-white hover:bg-slate-100 rounded-lg">
    ☰
  </button>
</div>


          </header>
        <% end %>

        <main class="px-4 md:px-6 py-6">
          <% flash.each do |type, message| %>
            <div class="<%= flash_class(type) %> mb-4 px-4 py-3 border text-sm">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <script>
      function setupSidebarMenu() {
        const sidebar = document.getElementById("sidebar");
        const openButton = document.getElementById("sidebar-open");
        const closeButton = document.getElementById("sidebar-close");
        const overlay = document.getElementById("sidebar-overlay");

        if (!sidebar || !openButton || !closeButton || !overlay) return;

        function openSidebar() {
          sidebar.classList.add("open");
          overlay.classList.remove("hidden");
        }

        function closeSidebar() {
          sidebar.classList.remove("open");
          overlay.classList.add("hidden");
        }

        openButton.onclick = openSidebar;
        closeButton.onclick = closeSidebar;
        overlay.onclick = closeSidebar;

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") closeSidebar();
        });

        window.addEventListener("resize", function () {
          if (window.innerWidth >= 768) closeSidebar();
        });
      }

      document.addEventListener("DOMContentLoaded", setupSidebarMenu);
      document.addEventListener("turbo:load", setupSidebarMenu);
    </script>
  </body>
</html>