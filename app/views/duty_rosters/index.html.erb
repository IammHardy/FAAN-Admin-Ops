<% content_for :page_title, "Duty Roster" %>

<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Duty Roster</h1>
    <p class="text-slate-500 mt-1">
      Manage who is scheduled to operate the Admin Office or Unit Office account.
    </p>
  </div>

  <%= link_to "Create Duty",
      new_duty_roster_path,
      class: "bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-800" %>
</div>

<div class="bg-white border border-slate-200 shadow-sm p-5 mb-6">
  <h2 class="font-semibold text-slate-900 mb-2">
    Generate Admin Office Weekly Roster
  </h2>

  <p class="text-sm text-slate-500 mb-4">
    Select Monday of the week. The system will generate the default Admin Office roster.
  </p>

  <%= form_with url: generate_admin_week_duty_rosters_path, method: :post, local: true, class: "flex flex-col md:flex-row gap-3" do %>
    <%= date_field_tag :week_start,
    Date.current.next_week(:monday),
    class: "rounded-lg border-slate-300" %>

    <%= submit_tag "Generate Weekly Roster",
        class: "bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-800" %>
  <% end %>
</div>
<div class="flex flex-wrap gap-2 mb-6">
  <%= link_to "Today",
      duty_rosters_path(filter: "today"),
      class: "px-4 py-2 rounded-lg text-sm #{params[:filter] == 'today' ? 'bg-green-700 text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'}" %>

  <%= link_to "This Week",
      duty_rosters_path(filter: "this_week"),
      class: "px-4 py-2 rounded-lg text-sm #{params[:filter].blank? || params[:filter] == 'this_week' ? 'bg-green-700 text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'}" %>

  <%= link_to "Next Week",
      duty_rosters_path(filter: "next_week"),
      class: "px-4 py-2 rounded-lg text-sm #{params[:filter] == 'next_week' ? 'bg-green-700 text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'}" %>

  <%= link_to "All",
      duty_rosters_path(filter: "all"),
      class: "px-4 py-2 rounded-lg text-sm #{params[:filter] == 'all' ? 'bg-green-700 text-white' : 'bg-white border border-slate-300 text-slate-700 hover:bg-slate-50'}" %>
</div>

<div class="space-y-6">
  <% @grouped_duty_rosters.each do |date, rosters| %>
    <div class="bg-white border border-slate-200 shadow-sm rounded-xl overflow-hidden">
      <div class="bg-slate-100 px-5 py-4 border-b border-slate-200">
        <h2 class="font-bold text-slate-900">
          <%= date.strftime("%A, %d %B %Y") %>
        </h2>

        <p class="text-sm text-slate-500 mt-1">
          <%= pluralize(rosters.count, "staff") %> on duty
        </p>
      </div>

      <div class="divide-y divide-slate-100">
        <% rosters.each do |roster| %>
          <div class="px-5 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div>
              <p class="font-semibold text-slate-900">
                <%= roster.operation_staff.display_name %>
              </p>

              <p class="text-sm text-slate-500">
                <%= roster.duty_area %>
                <% if roster.shift_name.present? %>
                  • <%= roster.shift_name %>
                <% end %>
              </p>
            </div>

            <div class="flex items-center gap-4">
              <% if roster.active? %>
                <span class="text-sm text-green-700 font-medium">Active</span>
              <% else %>
                <span class="text-sm text-red-600">Inactive</span>
              <% end %>

              <%= link_to "Edit",
                  edit_duty_roster_path(roster),
                  class: "text-blue-700 font-medium text-sm" %>

              <%= button_to "Delete",
                  duty_roster_path(roster),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete this duty roster?" } },
                  class: "text-red-600 font-medium bg-transparent border-0 p-0 cursor-pointer text-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @grouped_duty_rosters.empty? %>
    <div class="bg-white border border-slate-200 rounded-xl p-8 text-center text-slate-500">
      No duty roster found for this filter.
    </div>
  <% end %>
</div>

<% if @filter == "all" %>
  <div class="mt-6">
    <%= paginate @duty_rosters %>
  </div>
<% end %>
