<%= form_with(model: duty_roster, class: "space-y-6") do |form| %>
  <% if duty_roster.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <h2 class="font-semibold text-red-700 mb-2">Please fix the following:</h2>
      <ul class="list-disc ml-5 text-sm text-red-700">
        <% duty_roster.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white border border-slate-200 shadow-sm">
    <div class="border-b border-slate-200 bg-slate-50 px-6 py-5">
      <h2 class="text-lg font-semibold text-slate-800">Duty Details</h2>
      <p class="text-sm text-slate-500 mt-1">
        Assign who is scheduled to operate the platform for a duty area.
      </p>
    </div>

    <div class="p-6 space-y-6">
      <div>
        <%= form.label :duty_area, "Duty Area", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.select :duty_area,
            DutyRoster::DUTY_AREAS,
            { prompt: "Select duty area" },
            class: "w-full rounded-xl border border-slate-300 px-4 py-3 shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
        <p class="text-xs text-slate-500 mt-2">
          Admin Office covers records and dispatch. Unit Office covers unit logs and incoming memos.
        </p>
      </div>

      <div>
        <%= form.label :operation_staff_id, "Staff On Duty", class: "block text-sm font-semibold text-slate-700 mb-2" %>
        <%= form.collection_select :operation_staff_id,
            OperationStaff.duty_eligible,
            :id,
            :display_name,
            { prompt: "Select staff" },
            class: "w-full rounded-xl border border-slate-300 px-4 py-3 shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
        <p class="text-xs text-slate-500 mt-2">
          Only staff marked as “Can Be On Duty” will appear here.
        </p>
      </div>
      <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
  <%= form.check_box :always_present,
      class: "mt-1 rounded border-slate-300 text-green-700 focus:ring-green-600" %>

  <div>
    <%= form.label :always_present,
        "Always Present",
        class: "block text-sm font-semibold text-slate-700" %>

    <p class="text-xs text-slate-500 mt-1">
      Use this for HOD, HOU, Compliance Officers, or staff who are present every working day.
    </p>
  </div>
</div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <%= form.label :duty_date, "Duty Date", class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.date_field :duty_date,
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
        </div>

        <div>
          <%= form.label :shift_name, "Shift", class: "block text-sm font-semibold text-slate-700 mb-2" %>
          <%= form.select :shift_name,
              DutyRoster::UNIT_SHIFTS,
              { prompt: "Select shift (Unit Office only)" },
              class: "w-full rounded-xl border border-slate-300 px-4 py-3 shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
          <p class="text-xs text-slate-500 mt-2">
            Required for Unit Office. Leave blank for Admin Office.
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
        <%= form.check_box :active,
            class: "mt-1 rounded border-slate-300 text-green-700 focus:ring-green-600" %>

        <div>
          <%= form.label :active, "Active Duty Roster", class: "block text-sm font-semibold text-slate-700" %>
          <p class="text-xs text-slate-500 mt-1">
            Only active rosters can be selected when starting duty.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel",
        duty_rosters_path,
        class: "rounded-xl border border-slate-300 px-5 py-3 text-sm hover:bg-slate-100" %>

    <%= form.submit(
      duty_roster.persisted? ? "Update Duty Roster" : "Create Duty Roster",
      class: "rounded-xl bg-green-700 px-6 py-3 text-white font-semibold hover:bg-green-800"
    ) %>
  </div>
<% end %>