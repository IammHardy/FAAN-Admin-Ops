<div class="bg-white border border-gray-200">
  <% if @dispatches.any? %>
    <div class="overflow-x-auto w-full">
      <table class="min-w-[1000px] w-full text-sm whitespace-nowrap">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Reference No.</th>
            <th class="text-left px-4 py-3 font-semibold">Subject</th>
            <th class="text-left px-4 py-3 font-semibold">Memo Date</th>
            <th class="text-left px-4 py-3 font-semibold">From</th>
            <th class="text-left px-4 py-3 font-semibold">To</th>
            <th class="text-left px-4 py-3 font-semibold">Status</th>
            <th class="text-right px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @dispatches.each do |dispatch| %>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-3 font-medium"><%= dispatch.reference_number %></td>
              <td class="px-4 py-3"><%= dispatch.subject %></td>
              <td class="px-4 py-3"><%= dispatch.memo_date&.strftime("%d %b %Y") %></td>
              <td class="px-4 py-3"><%= dispatch.sender_department.name %></td>
              <td class="px-4 py-3"><%= dispatch.receiving_department.name %></td>

              <td class="px-4 py-3">
                <% display_status = dispatch.display_status %>

                <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium border
                  <%= case display_status
                      when 'Draft'
                        'bg-slate-50 border-slate-300 text-slate-700'
                      when 'Dispatched'
                        'bg-blue-50 border-blue-200 text-blue-700'
                      when 'Ready to File'
                        'bg-amber-50 border-amber-200 text-amber-700'
                      when 'Received'
                        'bg-green-50 border-green-200 text-green-700'
                      when 'Acknowledged'
                        'bg-emerald-50 border-emerald-200 text-emerald-700'
                      when 'Filed'
                        'bg-slate-100 border-slate-300 text-slate-800'
                      else
                        'bg-slate-50 border-slate-300 text-slate-700'
                      end %>">
                  <%= lucide_icon "circle", class: "w-3 h-3" %>
                  <%= display_status %>
                </span>

                <p class="text-xs text-gray-500 mt-1">
                  <%= dispatch.acknowledgement_progress %>
                </p>
              </td>

              <td class="px-4 py-3">
                <div class="flex justify-end gap-3">
                  <%= link_to dispatch_path(dispatch),
                      class: "inline-flex items-center gap-1 text-green-700 hover:text-green-800 font-medium" do %>
                    <%= lucide_icon "eye", class: "w-4 h-4" %>
                    View
                  <% end %>

                  <%= link_to edit_dispatch_path(dispatch),
                      class: "inline-flex items-center gap-1 text-slate-600 hover:text-slate-900 font-medium" do %>
                    <%= lucide_icon "pencil", class: "w-4 h-4" %>
                    Edit
                  <% end %>

                  <%= button_to dispatch_path(dispatch),
                      method: :delete,
                      form: { class: "inline-block", data: { turbo_confirm: "Are you sure you want to delete this dispatch record?" } },
                      class: "inline-flex items-center gap-1 text-red-600 hover:text-red-700 font-medium bg-transparent border-0 p-0 cursor-pointer" do %>
                    <%= lucide_icon "trash-2", class: "w-4 h-4" %>
                    Delete
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6 text-sm text-gray-500">
      No dispatch records found.
    </div>
  <% end %>
</div>

<% if @dispatches.respond_to?(:total_pages) %>
  <div class="mt-6">
    <%= paginate @dispatches %>
  </div>
<% end %>