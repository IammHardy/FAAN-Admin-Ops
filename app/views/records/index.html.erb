<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
      <%= lucide_icon "archive", class: "w-6 h-6 text-green-700" %>
      Records Archive
    </h1>

    <p class="text-gray-600">Search dispatch copies, memos, reports, nominal roll and other filed documents.</p>
  </div>

  <%= link_to new_record_path,
      class: "inline-flex items-center gap-2 bg-green-700 text-white px-4 py-2 rounded-lg hover:bg-green-800" do %>
    <%= lucide_icon "plus", class: "w-4 h-4" %>
    Add New Record
  <% end %>
</div>

<div class="bg-white p-4 rounded-xl shadow mb-6">
  <%= form_with url: records_path, method: :get, local: true, class: "grid grid-cols-1 md:grid-cols-5 gap-4" do %>
    <%= text_field_tag :query, params[:query], placeholder: "Search title, ref no, recipient...", class: "rounded-lg border-gray-300" %>

    <%= select_tag :category,
      options_for_select([["All Categories", ""]] + Record::CATEGORIES.map { |c| [c, c] }, params[:category]),
      class: "rounded-lg border-gray-300" %>

    <%= date_field_tag :filed_date, params[:filed_date], class: "rounded-lg border-gray-300" %>

    <%= date_field_tag :document_date, params[:document_date], class: "rounded-lg border-gray-300" %>

    <%= button_tag type: :submit,
        class: "inline-flex items-center justify-center gap-2 bg-gray-900 text-white rounded-lg px-4 py-2" do %>
      <%= lucide_icon "search", class: "w-4 h-4" %>
      Search
    <% end %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-gray-100 text-gray-700">
      <tr>
        <th class="text-left p-3">Title</th>
        <th class="text-left p-3">Category</th>
        <th class="text-left p-3">Filed Date</th>
        <th class="text-left p-3">Filed By</th>
        <th class="text-left p-3">Location</th>
        <th class="text-left p-3">Scan</th>
        <th class="text-left p-3">Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @records.each do |record| %>
        <tr class="border-t">
          <td class="p-3 font-medium"><%= record.title %></td>
          <td class="p-3"><%= record.category %></td>
          <td class="p-3"><%= record.filed_date %></td>
          <td class="p-3"><%= record.filed_by&.email %></td>
          <td class="p-3"><%= record.physical_location %></td>

          <td class="p-3">
            <% if record.attachment.attached? %>
              <span class="inline-flex items-center gap-1 text-green-700 font-medium">
                <%= lucide_icon "check-circle", class: "w-4 h-4" %>
                Yes
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-slate-500">
                <%= lucide_icon "circle", class: "w-4 h-4" %>
                No
              </span>
            <% end %>
          </td>

          <td class="p-3">
            <div class="flex flex-wrap gap-3 items-center">
              <%= link_to record_path(record),
                  class: "inline-flex items-center gap-1 text-green-700 font-medium" do %>
                <%= lucide_icon "eye", class: "w-4 h-4" %>
                View
              <% end %>

              <%= link_to edit_record_path(record),
                  class: "inline-flex items-center gap-1 text-blue-700 font-medium" do %>
                <%= lucide_icon "pencil", class: "w-4 h-4" %>
                Edit
              <% end %>

              <% if record.attachment.attached? %>
                <%= link_to download_attachment_record_path(record),
                    class: "inline-flex items-center gap-1 text-slate-700 font-medium" do %>
                  <%= lucide_icon "download", class: "w-4 h-4" %>
                  Download
                <% end %>
              <% end %>

              <%= button_to record_path(record),
                  method: :delete,
                  form: { data: { turbo_confirm: "Move this record to deleted records?" } },
                  class: "inline-flex items-center gap-1 text-red-600 font-medium bg-transparent border-0 p-0 cursor-pointer" do %>
                <%= lucide_icon "trash-2", class: "w-4 h-4" %>
                Delete
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>

      <% if @records.empty? %>
        <tr>
          <td colspan="7" class="p-6 text-center text-gray-500">
            No records found.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%= paginate @records if respond_to?(:paginate) %>
</div>