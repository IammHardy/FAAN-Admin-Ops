
<%= form_with(model: record, class: "space-y-8") do |form| %>

  <% if record.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-red-600 text-xl">⚠️</span>
        <h2 class="font-semibold text-red-700">
          Please correct the following:
        </h2>
      </div>

      <ul class="list-disc ml-6 text-sm text-red-700 space-y-1">
        <% record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white  shadow-sm border border-slate-200 overflow-hidden">

    <!-- Header -->
    <div class="border-b border-slate-200 px-6 py-5 bg-slate-50">
      <h2 class="text-lg font-semibold text-slate-800">
        Document Information
      </h2>

      <p class="text-sm text-slate-500 mt-1">
        Add details about the filed document for easy retrieval later.
      </p>
    </div>

    <div class="p-6 space-y-6">

      <!-- Title -->
      <div>
        <%= form.label :title,
            "Title / Subject",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_field :title,
            placeholder: "e.g. Staff Deployment Memo, June Monthly Report",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
      </div>

      <!-- Category -->
<!-- Category -->
<div>
  <%= form.label :category,
      "Document Category",
      class: "block text-sm font-semibold text-slate-700 mb-2" %>

  <%= form.select :category,
      grouped_options_for_select(
        {
          "General Records" => Record::GENERAL_CATEGORIES,
          "Staff Folder Documents" => Record::STAFF_DOCUMENT_TYPES
        },
        record.category
      ),
      { prompt: "Select document category" },
      class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

  <p class="text-xs text-slate-500 mt-2">
    Use General Records for office files. Use Staff Folder Documents for documents belonging to a specific staff.
  </p>
</div>

<!-- Staff Folder -->
<div>
  <%= form.label :operation_staff_id,
      "Staff Folder",
      class: "block text-sm font-semibold text-slate-700 mb-2" %>

  <%= form.collection_select :operation_staff_id,
      OperationStaff.alphabetical,
      :id,
      :display_name,
      { prompt: "Leave blank if this is not a staff document" },
      class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

  <p class="text-xs text-slate-500 mt-2">
    Select a staff member only if this document belongs inside their personal folder.
  </p>
</div>

      <!-- Dates -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <div>
          <%= form.label :document_date,
              "Document Date",
              class: "block text-sm font-semibold text-slate-700 mb-2" %>

          <%= form.date_field :document_date,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

          <p class="text-xs text-slate-500 mt-2">
            The actual date written on the document.
          </p>
        </div>

        <div>
          <%= form.label :filed_date,
              "Date Filed",
              class: "block text-sm font-semibold text-slate-700 mb-2" %>

          <%= form.date_field :filed_date,
              class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

          <p class="text-xs text-slate-500 mt-2">
            The date the document was filed physically.
          </p>
        </div>
      </div>

      <!-- Signed by -->
      <div>
        <%= form.label :signed_by,
            "Signed By",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_field :signed_by,
            placeholder: "e.g. HOD Operations, HOU Admin, Manager Ops",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>
      </div>

      <!-- Recipient -->
      <div>
        <%= form.label :recipient_or_source,
            "Recipient / Source",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_field :recipient_or_source,
            placeholder: "e.g. HR Unit, Safety Unit, Ministry of Aviation",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

        <p class="text-xs text-slate-500 mt-2">
          Who sent the document or who the document was addressed to.
        </p>
      </div>

      <!-- Reference number -->
      <div>
        <%= form.label :reference_number,
            "Reference Number",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_field :reference_number,
            placeholder: "e.g. FAAN/OPS/2026/014 (Optional)",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

        <p class="text-xs text-slate-500 mt-2">
          Leave blank if no official reference number exists.
        </p>
      </div>

      <!-- Physical Location -->
      <div>
        <%= form.label :physical_location,
            "Physical Storage Location",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_field :physical_location,
            placeholder: "e.g. Shelf B → Cabinet 2 → Internal Memo Folder → June 2026",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100" %>

        <p class="text-xs text-slate-500 mt-2">
          Specify exactly where the physical document is stored.
        </p>
      </div>

      <!-- Attachment -->
      <div>
        <%= form.label :attachment,
            "Scanned Copy / Photo / PDF",
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <div class=" border-2 border-dashed border-slate-300 bg-slate-50 p-5 hover:border-green-500 transition">
          <%= form.file_field :attachment,
              class: "block w-full text-sm text-slate-700
              file:mr-4
              file:rounded-lg
              file:border-0
              file:bg-green-700
              file:px-4
              file:py-2
              file:text-sm
              file:font-medium
              file:text-white
              hover:file:bg-green-800" %>

          <p class="mt-3 text-xs text-slate-500">
            Upload scanned signed document, image, or PDF copy.
          </p>
        </div>
      </div>

      <!-- Notes -->
      <div>
        <%= form.label :notes,
            class: "block text-sm font-semibold text-slate-700 mb-2" %>

        <%= form.text_area :notes,
            rows: 4,
            placeholder: "Additional notes about this document...",
            class: "w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-green-600 focus:ring-2 focus:ring-green-100 resize-none" %>
      </div>

    </div>
  </div>

  <!-- Submit -->
  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel",
        records_path,
        class: "rounded-xl border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100" %>

    <%= form.submit(
        record.persisted? ? "Update Record" : "Save Record",
        class: "rounded-xl bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-green-800 transition"
    ) %>
  </div>

<% end %>

